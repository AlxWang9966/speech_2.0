# Existing Azure Speech resource (file lab AND live microphone SDK).
# MAI also uses this resource unless overrides below are set.
SPEECH_AUTH_MODE=key
SPEECH_KEY=your_speech_resource_key
SPEECH_REGION=eastus
# Optional resource-root endpoint; otherwise the regional Speech endpoint is used.
# SPEECH_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# For a resource that disables keys, use SPEECH_AUTH_MODE=entra and set the
# custom SPEECH_ENDPOINT above. Sign in with Azure CLI; SPEECH_KEY is then ignored.

# Optional, separate MAI-capable Speech/Foundry resource.
# In key mode, set its own key AND endpoint or region.
# MAI_SPEECH_KEY=your_mai_speech_resource_key
# MAI_SPEECH_ENDPOINT=https://your-mai-resource.cognitiveservices.azure.com
# MAI_SPEECH_REGION=eastus
# For keyless access to a separate resource, set MAI_SPEECH_AUTH_MODE=entra
# and MAI_SPEECH_ENDPOINT. No MAI_SPEECH_KEY is needed in Entra mode.

# Optional: needed only for summaries and image analysis, not transcription.
GPT4o_AUTH_MODE=key
GPT4o_API_KEY=your_azure_openai_key
GPT4o_DEPLOYMENT_ENDPOINT=https://your-openai-resource.openai.azure.com/
GPT4o_DEPLOYMENT_NAME=your_gpt_4o_deployment
# If this original resource disables keys, set GPT4o_AUTH_MODE=entra.
# Keep its endpoint/deployment and sign in using Azure CLI; the old key is ignored.
# Aliases: AZURE_OPENAI_AUTH_MODE, AZURE_OPENAI_API_KEY, AZURE_OPENAI_ENDPOINT,
# AZURE_OPENAI_DEPLOYMENT, AZURE_OPENAI_API_VERSION. GPT4o_* takes precedence.
# GPT4o_API_VERSION=2024-02-01

# Optional: translation of live microphone captions after Stop.
# TRANSLATOR_AUTH_MODE=key
# TRANSLATOR_KEY=your_translator_key
# Use the ORIGINAL Translator region, never infer it from SPEECH_REGION.
# TRANSLATOR_REGION=your_original_region
# TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
# If this original resource disables keys, use TRANSLATOR_AUTH_MODE=entra.
# The global endpoint also requires the original resource ID (Azure portal > Properties):
# TRANSLATOR_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<original-translator-name>
# Alternatively set the ORIGINAL resource's custom HTTPS root; do not switch resources.
# TRANSLATOR_ENDPOINT=https://your-original-translator.cognitiveservices.azure.com/
